{
  "name": "htt",
  "version": "0.0.0",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4204",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "storybook": "ng run htt:storybook",
    "build-storybook": "ng run htt:build-storybook",
    "size": "ng build --stats-json",
    "display": "npx esbuild-visualizer --metadata=dist/htt/stats.json --open=true"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/service-worker": "22.2.3",
    "hue-map": "^1.0.0",
    "prettier": "^3.9.10",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@chromatic-com/storybook": "5.6.0",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-links": "10.6.3",
    "@storybook/angular-vite": "10.6.3",
    "@types/colormap": "2.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "storybook": "10.6.3",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.27.3": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true
  }
